# Глобальные опции Caddy
{
    email {$ACME_EMAIL:admin@example.com}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "0"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# Перманентный бан IP-адресов сканеров (список задаётся через BANNED_CLIENT_IPS в .env)
(banned_ips) {
    @banned_remote_ips {
        client_ip {$BANNED_CLIENT_IPS:192.0.2.254}
    }
    abort @banned_remote_ips
}

# Дроп запросов без валидного доменного имени (прямой доступ по IP-адресу)
(enforce_host) {
    @invalid_host {
        not host {$DOMAIN:localhost} localhost 127.0.0.1
    }
    abort @invalid_host
}

# Web Application Firewall (WAF) правила фильтрации вредоносных запросов
(waf_filter) {
    # 1. Блокировка попыток зондирования служебных файлов, RCE и панелей управления
    @blocked_probes {
        path /.git* /.env* /.aws* /.svn* /.htaccess* /wp-admin* /wp-login* /phpmyadmin* /actuator* /boaform* /shell* /admin.php* /config* /vendor/phpunit* /eval* /phpinfo* /debug* /webroot* /firebase* /gcp* /credentials*
        path_regexp "(?i)(\.php|\.env|\.git|\.svn|eval-stdin|laravel-filemanager)"
    }
    respond @blocked_probes 404

    # 2. Блокировка известных сканеров уязвимостей и спам-ботов
    @malicious_user_agents {
        header_regexp User-Agent "(?i)(sqlmap|nikto|masscan|nmap|acunetix|dirbuster|gobuster|wpscan|censys|shodan|zgrab|jorgee)"
    }
    respond @malicious_user_agents 403

    # 3. Блокировка атак Path Traversal
    @path_traversal {
        path_regexp "(?i)(\.\./|\.\.\\|%2e%2e)"
    }
    respond @path_traversal 400

    # 4. Блокировка внешнего доступа к внутренним метрикам (SEC-005)
    @blocked_metrics {
        path /metrics*
    }
    respond @blocked_metrics 403
}

(common_proxy) {
    encode zstd gzip

    request_body {
        max_size 15MB
    }

    # Чувствительные административные эндпоинты (создание и изменение отделов, удаление данных,
    # вход в систему) маршрутизируются в Python FastAPI, где полностью реализован RBAC, аудит,
    # защита от перебора и двухфакторная аутентификация.
    @admin_departments {
        path /api/v1/departments*
        method POST PUT DELETE
    }
    handle @admin_departments {
        reverse_proxy web-admin:8000 {
            header_up Host {host}
        }
    }

    @admin_sensitive_api {
        path /api/v1/auth/login* /api/v1/auth/2fa* /api/v1/auth/logout* /api/v1/users* /api/v1/vk/*
    }
    handle @admin_sensitive_api {
        reverse_proxy web-admin:8000 {
            header_up Host {host}
        }
    }

    # Проксирование запросов к Go API
    handle /api/v1/* {
        reverse_proxy go-api:8080 {
            header_up Host {host}
        }
    }

    # Основная веб-панель (FastAPI)
    handle {
        reverse_proxy web-admin:8000 {
            header_up Host {host}
        }
    }
}

# Домен за Tailscale Funnel / Reverse Proxy (HTTP режим без бесконечного редиректа 308)
http://{$DOMAIN:localhost}, :80 {
    import security_headers
    import banned_ips
    import enforce_host
    import waf_filter
    import common_proxy
}
