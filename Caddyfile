# Глобальные опции Caddy
{
    email {$ACME_EMAIL:admin@example.com}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "0"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

(common_proxy) {
    encode zstd gzip

    request_body {
        max_size 15MB
    }

    # API запросы проксируются на бэкенд (Python / Go Fiber)
    handle /api/* {
        reverse_proxy web-admin:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /auth/* {
        reverse_proxy web-admin:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /webhooks/* {
        reverse_proxy web-admin:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # React SPA: раздача статики напрямую Caddy с кэшированием и fallback на index.html
    handle {
        root * /var/www/frontend/dist
        try_files {path} /index.html
        file_server
    }
}

# Основной защищённый домен (HTTPS с автоматическим SSL-сертификатом)
{$DOMAIN:localhost} {
    import security_headers
    import common_proxy
}
