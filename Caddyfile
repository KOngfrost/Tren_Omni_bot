{
    auto_https disable_redirects
}

(common_proxy) {
    reverse_proxy web-admin:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Публичный домен DuckDNS (Let's Encrypt SSL, веб-панель и Telegram WebApp)
{$DOMAIN:example-bot.duckdns.org} {
    import common_proxy
}

# Доступ по HTTP через NetBird VPN, localhost и MagicDNS
http://localhost, http://127.0.0.1, http://100.64.0.1, http://oss-web-panel.example.netbird.cloud, http://oss-web-panel.example.netbird.cloud {
    import common_proxy
}

# Доступ по HTTPS внутри NetBird VPN
https://oss-web-panel.example.netbird.cloud, https://oss-web-panel.example.netbird.cloud {
    tls internal
    import common_proxy
}

