{
    auto_https disable_redirects
}

(common_proxy) {
    reverse_proxy web-admin:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Основной защищённый домен (HTTPS с автоматическим SSL-сертификатом).
# Имя домена задаётся в переменной окружения DOMAIN в файле .env (по умолчанию localhost для dev).
{$DOMAIN:localhost} {
    import common_proxy
}

# Внутренний трафик (порт 80: NetBird VPN, локальные адреса localhost/127.0.0.1)
:80 {
    import common_proxy
}


