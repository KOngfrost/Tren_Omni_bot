# Caddyfile: Автоматический HTTPS для Telegram Mini App через DuckDNS
example-bot.duckdns.org {
    reverse_proxy web-admin:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
