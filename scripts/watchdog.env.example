# конфигурация внешнего сторожа yen_watchdog для сервера oss

CHECK_INTERVAL_OK=900
CHECK_INTERVAL_FAIL=300
FAIL_THRESHOLD_MAINTENANCE=2

# id главного администратора (для бота "мозг")
ADMIN_CHAT_ID=6665679072

# белый список id администраторов, имеющих доступ к боту check_me_up (через запятую)
SERVER_ALERT_ADMIN_IDS=6665679072

# токен бота Check_me_up для алертов о недоступности сервера/пк
BOT_TOKEN_SERVER=

# токен бота "мозг" для алертов о сбоях контейнеров и сайта
BOT_TOKEN_BRAIN=

# параметры подключения к серверу oss
OSS_SSH_TARGET=ossadmin@100.120.28.104
OSS_WEB_URL=https://oss.tail5d7c2e.ts.net/health
STATE_FILE=/home/user/oss_watchdog/state.json
ADMINS_FILE=/home/user/oss_watchdog/server_admins.json
TELEGRAM_PROXY=http://127.0.0.1:10809
