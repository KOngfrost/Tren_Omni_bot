# Простая сборка для веб-админки
# ---- builder ----
FROM python:3.11-slim-bookworm@sha256:2333bd330d12de02514770b3585cad313644316047cdee24a7acfdece6de6efb AS builder

WORKDIR /build
COPY requirements.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt \
    && /opt/venv/bin/pip uninstall -y pip setuptools wheel

# ---- runtime ----
FROM python:3.11-slim-bookworm@sha256:2333bd330d12de02514770b3585cad313644316047cdee24a7acfdece6de6efb

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Устанавливаем зависимости системы
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Создаём непривилегированного пользователя (запуск НЕ от root — безопасность)
RUN useradd --create-home --shell /bin/bash appuser

# Устанавливаем рабочие директории
WORKDIR /app

# В runtime переносим только виртуальное окружение без pip и build-инструментов.
COPY --from=builder /opt/venv /opt/venv
RUN rm -rf /usr/local/lib/python3.11/ensurepip \
    /usr/local/lib/python3.11/site-packages/pip \
    /usr/local/lib/python3.11/site-packages/pip-*.dist-info \
    /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.11

# Копируем код приложения
COPY . .

# Права на файлы приложения для appuser
RUN chown -R appuser:appuser /app

USER appuser

# Открываем порт для веб-админки
EXPOSE 8000

# Запускаем веб-админку в многоворкерном режиме (2+ воркера).
# Сессии хранятся в Redis (RedisSessionMiddleware), поэтому распределение
# запросов между воркерами безопасно и не приводит к рассинхронизации.
CMD ["sh", "-c", "exec uvicorn web.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_WORKERS:-2} --limit-max-requests 1000 --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:-127.0.0.1,172.16.0.0/12,10.0.0.0/8}\""]
