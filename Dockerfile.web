# Простая сборка для веб-админки
FROM python:3.11-slim-bookworm

# Устанавливаем зависимости системы
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Создаём непривилегированного пользователя (запуск НЕ от root — безопасность)
RUN useradd --create-home --shell /bin/bash appuser

# Устанавливаем рабочие директории
WORKDIR /app

# Копируем requirements и устанавливаем зависимости
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Копируем код приложения
COPY . .

# Права на файлы приложения для appuser
RUN chown -R appuser:appuser /app

USER appuser

# Открываем порт для веб-админки
EXPOSE 8000

# Запускаем веб-админку в многоворкерном режиме (2+ воркера).
# Сессии хранятся в Redis (RedisSessionMiddleware), поэтому распределение
# запросов между воркерами безопасно и не приводит к рассинхронизации.
CMD ["sh", "-c", "uvicorn web.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_WORKERS:-2}"]
