# ============================================================
# OSS Bot - Конфигурация
# ============================================================
# ВНИМАНИЕ: Никогда не коммитьте .env в Git!
# .env уже добавлен в .gitignore.
# ============================================================

# === Версия приложения ===
APP_VERSION=0.8.8.1

# === Database ===
# Пользователь и пароль НЕ должны быть дефолтными (oss_bot/student_bot запрещены
# в production). Пароль - не короче 12 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=oss_bot
POSTGRES_PASSWORD=change_me_to_a_long_secret
POSTGRES_DB=oss_bot

# Для прямого подключения к PostgreSQL (или при локальной разработке):
# DB_HOST=db
# DB_PORT=5432
# DB_USE_PGBOUNCER=false
#
# Для работы через PgBouncer (docker-compose, режим transaction pooling):
# DB_HOST=pgbouncer
# DB_PORT=6432
# DB_USE_PGBOUNCER=true
DB_HOST=db
DB_PORT=5432
DB_USE_PGBOUNCER=false

# Пул подключений к PostgreSQL (производительность при >2500 пользователей).
# Не меняйте без необходимости: значения ниже рассчитаны на средний сервер.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800

# === VK Bot ===
# Токен сообщества ВКонтакте (Управление -> Работа с API -> Ключи доступа)
VK_BOT_TOKEN=

# VK ID администраторов через запятую (доступ к админ-командам бота)
ADMIN_VK_IDS=

# VK ID получателя ежедневных отчётов
VK_REPORT_ADMIN_ID=

# Ссылка на группу/бота ВКонтакте (отображается студентам при техработах)
VK_GROUP_URL=https://vk.com/your_community

# Время ежедневного отчёта в формате HH:MM (в часовом поясе APP_TIMEZONE)
REPORT_TIME=09:00

# Часовой пояс для отчётов и отображения времени (даты в БД - в UTC)
APP_TIMEZONE=Europe/Moscow

# Dev-режим: разрешить приложению создавать базу (CREATE DATABASE).
# В PRODUCTION должно быть false - базу создаёт PostgreSQL-контейнер (POSTGRES_DB),
# схему применяет Alembic (docker compose run --rm migrate).
ALLOW_DB_CREATE=false

# === Web admin panel ===
# Доменное имя для веб-панели и Telegram WebApp (используется Caddy для автоматического Let's Encrypt SSL)
DOMAIN=your-domain.duckdns.org

# Стабильный секрет сессий (сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))")
SESSION_SECRET_KEY=

# HTTPS-only для session-cookie:
#   true - панель за Tailscale HTTPS (tailscale serve): кука помечается Secure.
#   false - только для локальной разработки по HTTP.
# setup_tailscale.sh автоматически ставит true.
SESSION_HTTPS_ONLY=true

# Доверенные reverse-proxy (их IP/подсети через запятую), от которых принимается
# настоящий IP клиента из заголовка X-Forwarded-For (нужно для rate-limit).
# В Docker обязательно указывать подсети docker bridge:
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Разрешённые CORS-origin веб-панели (через запятую).
CORS_ORIGINS=http://localhost:8000

# Формат логов: text (по умолчанию) или json (для ELK/Loki).
LOG_FORMAT=text

# Окружение: development | production.
APP_ENV=production

# Логин и пароль для входа в веб-админку (bootstrap-суперадмин).
WEB_ADMIN_USERNAME=
WEB_ADMIN_PASSWORD=

# === Outbox (доставка VK-уведомлений из очереди) ===
WEB_OUTBOX_WORKER=true

# === Redis & Кэширование (опционально) ===
# URL подключения к Redis для распределённых сессий и кэша
REDIS_URL=redis://oss_bot_redis:6379/0
CACHE_DEFAULT_TTL=300
SESSION_TTL=86400

# === Распределённая блокировка фоновых задач (Redis, core/task_dispatcher.py) ===
# TTL блокировки в секундах: через это время замок считается "просроченным",
# если процесс не продлил его. Должен быть больше интервала продления.
DISTRIBUTED_LOCK_TTL_SECONDS=30
# Интервал автоматического продления блокировки (каждые N секунд TTL обновляется).
# По умолчанию TTL/3 ≈ 10 сек.
DISTRIBUTED_LOCK_RENEW_INTERVAL_SECONDS=10

# === FSM-состояния VK-бота (Redis, core/state_dispenser.py) ===
# TTL состояния диалога студента в секундах. При каждом шаге диалога
# продлевается, брошенные диалоги автоматически удаляются из Redis.
# Позволяет масштабировать WEB_WORKERS>1 в режиме VK_MODE=callback:
# FSM-состояние общее для всех воркеров Uvicorn, шаги создания заявки
# не теряются между последовательными запросами на разные воркеры.
BOT_STATE_TTL_SECONDS=3600

# === Sentry (мониторинг ошибок, опционально) ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# === Двухфакторная аутентификация (2FA) ===
# Одноразовый код при входе в веб-панель. Обязательна для ВСЕХ ролей панели:
# без доверенного канала вход блокируется (fail-closed), а не разрешается.
TWO_FACTOR_ENABLED=true
TWO_FACTOR_CODE_TTL=300
# VK ID для доставки кода bootstrap-суперадмину из .env.
# 0 = используется VK_REPORT_ADMIN_ID; если не задан ни один - bootstrap-вход
# при TWO_FACTOR_ENABLED невозможен.
WEB_ADMIN_2FA_VK_ID=0
# Максимум неверных вводов кода на одну попытку входа (сверх - отмена входа)
WEB_ADMIN_2FA_MAX_ATTEMPTS=5
# Максимум повторных отправок кода на одну попытку (защита от флуда VK)
WEB_ADMIN_2FA_RESEND_LIMIT=3

# === Bootstrap-доступ (раздел 5 ТЗ) ===
# BOOTSTRAP_ALLOWED=false полностью отключает вход по креденциалам из .env
# (в том числе отзывает уже выданные bootstrap-сессии).
BOOTSTRAP_ALLOWED=true
# Разрешить запуск с placeholder-секретами (ТОЛЬКО локальная разработка).
# В production страж старта всё равно прервёт запуск.
WEB_BOOTSTRAP_ALLOW_PLACEHOLDER_SECRETS=false


# === Режим воркеров веб-панели ===
# Количество uvicorn workers (по умолчанию 2)
WEB_WORKERS=2

# === Email-рассылка отчётов (опционально) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAILS=

# === Telegram Monitoring Bot (мониторинг сервера и алерты глав-админу) ===
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID главного администратора (узнать у @userinfobot)
# Бот будет реагировать ТОЛЬКО на этого пользователя, игнорируя остальных
TELEGRAM_ADMIN_ID=
# Включить автоматические алерты при сбоях контейнеров и нехватке ресурсов
TELEGRAM_ALERTS_ENABLED=true
# Интервал проверки здоровья контейнеров в секундах
TELEGRAM_CHECK_INTERVAL_SECONDS=30
# Email для регистрации Let's Encrypt SSL-сертификатов в Caddy
ACME_EMAIL=admin@example.com

# URL веб-панели для Telegram Mini App (если не задан, формируется автоматически из https://DOMAIN)
TELEGRAM_WEBAPP_URL=https://your-domain.duckdns.org

# === Go Backend API ===
# Разрешённые CORS-домены для Go API (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000, http://127.0.0.1:3000, http://localhost:8000

# === Безопасность и лимиты (все числовые параметры настраиваются здесь) ===
# Резервное копирование: каталог и срок хранения локальных дампов (дней)
BACKUP_DIR=/var/backups/oss_bot
BACKUP_ROTATION_DAYS=7

# Массовый импорт FAQ / Базы знаний (SEC-10): макс. размер файла (байт) и макс. строк
MAX_IMPORT_FILE_SIZE=5242880
MAX_IMPORT_ROWS=1000

# Ограничение частоты подачи обращений в VK-боте (SEC-08): заявок за интервал (сек)
VK_TICKET_RATE_LIMIT=3
VK_TICKET_RATE_WINDOW_SECONDS=300

# Ограничение частоты CRUD-операций в веб-панели: операций на IP за интервал (сек)
CRUD_RATE_LIMIT_MAX=60
CRUD_RATE_LIMIT_WINDOW=300



