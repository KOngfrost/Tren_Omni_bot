# ============================================================
# OSS Bot - Конфигурация
# ============================================================
# ВНИМАНИЕ: Никогда не коммитьте .env в Git!
# .env уже добавлен в .gitignore.
# ============================================================

# === Database ===
# Пользователь и пароль НЕ должны быть дефолтными (oss_bot/student_bot запрещены
# в production). Пароль - не короче 12 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=oss_bot
POSTGRES_PASSWORD=change_me_to_a_long_secret
POSTGRES_DB=oss_bot
DB_HOST=db
DB_PORT=5432

# Пул подключений к PostgreSQL (производительность при >2500 пользователей).
# Не меняйте без необходимости: значения ниже рассчитаны на средний сервер.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800

# === VK Bot ===
# Токен сообщества ВКонтакте (Управление -> Работа с API -> Ключи доступа)
VK_BOT_TOKEN=

# VK ID администраторов через запятую (доступ к админ-командам бота)
ADMIN_VK_IDS=

# VK ID получателя ежедневных отчётов
VK_REPORT_ADMIN_ID=

# Время ежедневного отчёта в формате HH:MM (в часовом поясе APP_TIMEZONE)
REPORT_TIME=09:00

# Часовой пояс для отчётов и отображения времени (даты в БД - в UTC)
APP_TIMEZONE=Europe/Moscow

# Dev-режим: разрешить приложению создавать базу (CREATE DATABASE).
# В PRODUCTION должно быть false - базу создаёт PostgreSQL-контейнер (POSTGRES_DB),
# схему применяет Alembic (docker compose run --rm migrate).
ALLOW_DB_CREATE=false

# === Web admin panel ===
# Стабильный секрет сессий (сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))")
SESSION_SECRET_KEY=

# HTTPS-only для session-cookie:
#   true - панель за Tailscale HTTPS (tailscale serve): кука помечается Secure.
#   false - только для локальной разработки по HTTP.
# setup_tailscale.sh автоматически ставит true.
SESSION_HTTPS_ONLY=true

# Доверенные reverse-proxy (их IP через запятую), от которых принимается
# настоящий IP клиента из заголовка X-Forwarded-For (нужно для rate-limit).
TRUSTED_PROXIES=

# Разрешённые CORS-origin веб-панели (через запятую).
# По умолчанию http://localhost:8000 (dev). Для production перечислите
# ваши домены, например: https://oss-web-panel.<tailnet>.ts.net
CORS_ORIGINS=http://localhost:8000

# Формат логов: text (по умолчанию) или json (для ELK/Loki).
LOG_FORMAT=text

# Окружение: development | production.
# В production запрещены дефолтные креды БД, слабые пароли и пустой
# SESSION_SECRET_KEY - приложение откажется запускаться.
APP_ENV=production

# Логин и пароль для входа в веб-админку (bootstrap-суперадмин).
# Используются только пока в web_users нет пользователей.
# Постоянных пользователей создавайте: python scripts/create_web_user.py
WEB_ADMIN_USERNAME=
WEB_ADMIN_PASSWORD=

# === Outbox (доставка VK-уведомлений из очереди) ===
# Фоновый воркер очереди в веб-панели: при WEB_WORKERS>1 исполнителем
# становится ровно один процесс (PostgreSQL advisory lock,
# core/task_dispatcher.py). false — если доставку выполняет только бот.
WEB_OUTBOX_WORKER=true

# === Tailscale (обязателен) ===
# Tailscale-контейнер запускается ВМЕСТЕ со стеком (docker compose up -d),
# веб-панель доступна ТОЛЬКО внутри tailnet, наружу порты не публикуются.
# Auth key из https://login.tailscale.com/admin/settings/keys
# После первого запуска включите HTTPS: ./scripts/setup_tailscale.sh
TAILSCALE_AUTH_KEY=

# === Redis & Кэширование (опционально) ===
# URL подключения к Redis для распределённых сессий и кэша
REDIS_URL=redis://oss_bot_redis:6379/0
CACHE_DEFAULT_TTL=300
SESSION_TTL=86400

# === Sentry (мониторинг ошибок, опционально) ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# === Двухфакторная аутентификация (2FA) ===
# Отправка одноразового кода в ВК при входе в веб-панель
TWO_FACTOR_ENABLED=true
TWO_FACTOR_CODE_TTL=300

# === Режим воркеров веб-панели ===
# Количество uvicorn workers (по умолчанию 2)
WEB_WORKERS=2

# === Email-рассылка отчётов (опционально) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAILS=

